# Copy to .env (gitignored). Values come from the Anthropic organization
# that holds your BAA with zero data retention enabled.
PHI_DELEGATE_API_KEY=
PHI_DELEGATE_ZDR_ATTESTED=0
# PHI_DELEGATE_MODEL=claude-opus-5
# PHI_DELEGATE_CONFIG_DIR=$HOME/.phi-delegate/claude
# Optional model detector for phi-scan.sh (install with scripts/setup-detector.sh)
# PHI_DELEGATE_DETECTOR=pii-tracer
# PHI_DELEGATE_DETECTOR_PYTHON=$HOME/.phi-delegate/detector/venv/bin/python
# PHI_DELEGATE_DETECTOR_DIR=$HOME/.phi-delegate/detector/pii-tracer
